# ---------------------------------------------------------------------------
# Nerjaveyka API - пример конфигурации.
# Скопируйте файл в .env и заполните значения под своё окружение.
# .env не коммитится в репозиторий.
# ---------------------------------------------------------------------------

# --- Django ---------------------------------------------------------------
# В production обязательно DJANGO_DEBUG=False.
DJANGO_DEBUG=True

# Сгенерировать ключ:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# Хосты через запятую (без пробелов), например: api.example.com,www.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Доверенные origin'ы для CSRF (со схемой), например: https://api.example.com
CSRF_TRUSTED_ORIGINS=

# Разрешённые origin'ы для CORS (со схемой), например: https://example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Принудительный редирект на HTTPS. В production включён по умолчанию.
# Отключить можно только для отладки, например при проблемах с прокси:
# DJANGO_SECURE_SSL_REDIRECT=False

# --- База данных ----------------------------------------------------------
# Если не задано, в DEBUG-режиме используется db.sqlite3.
# В production DATABASE_URL обязателен.
# DATABASE_URL=postgres://nerjaveyka:change-me@localhost:5432/nerjaveyka

# --- Файлы -----------------------------------------------------------------
# По умолчанию media/ рядом с manage.py. Оставьте пустым, чтобы не переопределять.
# DJANGO_MEDIA_ROOT=/var/lib/nerjaveyka/media

# --- Почта -----------------------------------------------------------------
# В DEBUG-режиме письма выводятся в консоль, SMTP не используется.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost
EMAIL_TIMEOUT=10

# --- Docker Compose --------------------------------------------------------
POSTGRES_DB=nerjaveyka
POSTGRES_USER=nerjaveyka
POSTGRES_PASSWORD=change-me
WEB_PORT=8000
GUNICORN_WORKERS=3

# --- PythonAnywhere --------------------------------------------------------
# Готовый шаблон для площадки: deploy/pythonanywhere/.env.example
# Инструкция: PYTHONANYWHERE.md
