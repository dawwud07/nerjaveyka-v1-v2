# ---------------------------------------------------------------------------
# Nerjaveyka API - конфигурация для PythonAnywhere.
# Скопируйте файл в ~/nerjaveyka/.env и замените YOUR_USERNAME и секреты.
# .env не коммитится в git.
# ---------------------------------------------------------------------------

# --- Django ---------------------------------------------------------------
DJANGO_DEBUG=False

# Сгенерировать ключ в Bash-консоли PythonAnywhere:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# Домен бесплатного аккаунта. Для своего домена добавьте его сюда.
DJANGO_ALLOWED_HOSTS=YOUR_USERNAME.pythonanywhere.com,www.YOUR_USERNAME.pythonanywhere.com

CSRF_TRUSTED_ORIGINS=https://YOUR_USERNAME.pythonanywhere.com,https://www.YOUR_USERNAME.pythonanywhere.com

# Домены фронтенда, которым разрешены запросы к API (без слэша на конце).
# Для локальной разработки:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# В production замените на реальный домен, например:
# CORS_ALLOWED_ORIGINS=https://example.com

# Аварийный вариант для быстрой проверки. Не включайте в production:
# CORS_ALLOW_ALL_ORIGINS=True

# Обычно редирект на HTTPS нужен. Если после деплоя возникает цикл
# редиректов, временно раскомментируйте строку ниже:
# DJANGO_SECURE_SSL_REDIRECT=False

# --- База данных ----------------------------------------------------------
# По умолчанию используется SQLite в каталоге проекта (4 слэша!).
DATABASE_URL=sqlite:////home/YOUR_USERNAME/nerjaveyka/db.sqlite3

# Вариант с MySQL PythonAnywhere (нужен пакет mysqlclient; MySQL доступен
# на платных тарифах и на бесплатных аккаунтах, созданных до 15.01.2026):
# DATABASE_URL='mysql://YOUR_USERNAME:DB_PASSWORD@YOUR_USERNAME.mysql.pythonanywhere-services.com/YOUR_USERNAME$nerjaveyka'

# --- Файлы -----------------------------------------------------------------
DJANGO_MEDIA_ROOT=/home/YOUR_USERNAME/nerjaveyka/media

# --- Почта -----------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost
EMAIL_TIMEOUT=10
